# code pour vérifier avec la rdm ou creer des points de test
def rdm(L, b, h, P, E):
    I =b * h**3 / 12.0
    delta = P*L**3 /(3*E*I)
    sigma = P * L * (h / 2.0) / I
    masse = RHO * b * h * L
    return delta, sigma, masse